# Copy this file to ".env" in the project folder (next to pom.xml) and fill in real values.
# .env is listed in .gitignore - never commit or share it.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/bookly_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Administrator login for /admin/login (created or updated when the app starts; min 8 characters)
BOOKLY_ADMIN_EMAIL=admin@bookly.local
BOOKLY_ADMIN_PASSWORD=choose-a-strong-password
BOOKLY_ADMIN_NAME=Bookly Admin

# Insert the 18 sample books if they are missing (true/false)
BOOKLY_SEED=true
